<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.empresa.platform</groupId>
    <artifactId>platform-libraries-bom</artifactId>
    <version>1.1.0</version>
    <packaging>pom</packaging>

    <name>Golden Platform Libraries BOM</name>
    <description>BOM das capabilities reutilizáveis da Golden Platform.</description>

    <properties>
        <platform-libraries.version>1.1.0</platform-libraries.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency><groupId>com.empresa.platform</groupId><artifactId>platform-starter</artifactId><version>${platform-libraries.version}</version></dependency>
            <dependency><groupId>com.empresa.platform</groupId><artifactId>platform-logging</artifactId><version>${platform-libraries.version}</version></dependency>
            <dependency><groupId>com.empresa.platform</groupId><artifactId>platform-messaging</artifactId><version>${platform-libraries.version}</version></dependency>
            <dependency><groupId>com.empresa.platform</groupId><artifactId>platform-authorization</artifactId><version>${platform-libraries.version}</version></dependency>
            <dependency><groupId>com.empresa.platform</groupId><artifactId>platform-audit</artifactId><version>${platform-libraries.version}</version></dependency>
            <dependency><groupId>com.empresa.platform</groupId><artifactId>platform-catalog</artifactId><version>${platform-libraries.version}</version></dependency>
            <dependency><groupId>com.empresa.platform</groupId><artifactId>platform-tagging</artifactId><version>${platform-libraries.version}</version></dependency>
            <dependency><groupId>com.empresa.platform</groupId><artifactId>platform-test-support</artifactId><version>${platform-libraries.version}</version></dependency>
        </dependencies>
    </dependencyManagement>

    <distributionManagement>
        <repository>
            <id>github-platform-libraries</id>
            <name>GitHub Packages - Platform Libraries</name>
            <url>https://maven.pkg.github.com/brunobs/platform-libraries</url>
        </repository>
    </distributionManagement>
</project>
