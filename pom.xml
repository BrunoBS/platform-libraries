<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.empresa.platform</groupId>
        <artifactId>platform-parent</artifactId>
        <version>1.0.0</version>
        <relativePath/>
    </parent>

    <artifactId>platform-libraries</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>platform-libraries</name>

    <repositories>
        <repository>
            <id>github-platform-build</id>
            <name>GitHub Packages - Platform Build</name>
            <url>https://maven.pkg.github.com/BrunoBS/platform-build</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>true</enabled></snapshots>
        </repository>
    </repositories>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.empresa.platform</groupId>
                <artifactId>platform-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.empresa.platform</groupId>
                <artifactId>platform-messaging</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.empresa.platform</groupId>
                <artifactId>platform-authorization</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.empresa.platform</groupId>
                <artifactId>platform-logging</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.empresa.platform</groupId>
                <artifactId>platform-test-support</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.empresa.platform</groupId>
                <artifactId>platform-catalog</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.empresa.platform</groupId>
                <artifactId>platform-crud</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <modules>
        <module>platform-messaging</module>
        <module>platform-authorization</module>
        <module>platform-logging</module>
        <module>platform-starter</module>
        <module>platform-test-support</module>
        <module>platform-catalog</module>
        <module>platform-crud</module>
    </modules>
</project>
