<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.empresa.platform</groupId>
        <artifactId>platform-libraries</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>platform-authorization</artifactId>
    <packaging>jar</packaging>

    <dependencies>
        <!-- Dependência interna da plataforma corporativa -->
        <dependency>
            <groupId>com.empresa.platform</groupId>
            <artifactId>platform-messaging</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Spring Boot Starter Web (Versão automática do Spring Boot 4) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Dependência do Spring AOP (Versão automática do Spring Boot 4) -->
        <!-- Suporte nativo a AOP e Aspectos no Spring Boot 4 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aspectj</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Suporte a resiliência (A versão será injetada via dependencyManagement do pai) -->
        <dependency>
            <groupId>org.springframework.retry</groupId>
            <artifactId>spring-retry</artifactId>
        </dependency>


        <!-- Dependências de Teste (Versão automática do Spring Boot 4) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
